<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Company Info Editor | TechnoTherm Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/src/index.css">
</head>
<body style="background: #090d16; color: #fff;">

  <div style="background: #0d1322; border-bottom: 1px solid var(--border-subtle); padding: 1rem 0;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
      <div style="font-weight: 800; font-size: 1.2rem;">Company Details & <span style="color: var(--accent-green);">Chairman Message</span></div>
      <div>
        <a href="/admin/dashboard" style="color: var(--text-muted); font-size: 0.9rem; margin-right: 1rem;">← Dashboard</a>
        <a href="/admin/logout" style="color: #f87171; font-size: 0.9rem;">Logout</a>
      </div>
    </div>
  </div>

  <div class="container" style="padding: 2.5rem 0;">
    
    <div class="card-glass" style="padding: 2.5rem; max-width: 840px; margin: 0 auto; border: 1px solid var(--border-bright);">
      
      <div style="margin-bottom: 2rem;">
        <h1 style="font-size: 1.8rem; font-weight: 800; margin-bottom: 0.5rem;">Edit Corporate Info & Addresses</h1>
        <p style="color: var(--text-muted); font-size: 0.9rem;">Update Chairman message, quotes, factory address, and contact channels.</p>
      </div>

      <% if (typeof success !== 'undefined' && success) { %>
        <div style="background: rgba(16,185,129,0.15); border: 1px solid rgba(16,185,129,0.4); color: #34d399; padding: 0.75rem; border-radius: 6px; font-size: 0.9rem; margin-bottom: 1.5rem; text-align: center;">
          <%= success %>
        </div>
      <% } %>

      <form action="/admin/company-info" method="POST">
        
        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Company Name</label>
          <input type="text" name="name" value="<%= company.name %>" style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;">
        </div>

        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Chairman Name</label>
          <input type="text" name="chairmanName" value="<%= (company.chairman && company.chairman.name) || '' %>" style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;">
        </div>

        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Chairman Highlight Quote</label>
          <input type="text" name="chairmanQuote" value="<%= (company.chairman && company.chairman.quote) || '' %>" style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;">
        </div>

        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Full Chairman Address Message</label>
          <textarea name="chairmanMessage" rows="5" style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;"><%= (company.chairman && company.chairman.message) || '' %></textarea>
        </div>

        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Factory Address</label>
          <textarea name="address" rows="2" style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;"><%= (company.contact && company.contact.address) || '' %></textarea>
        </div>

        <div style="margin-bottom: 1.75rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Primary Email Address</label>
          <input type="email" name="email" value="<%= (company.contact && company.contact.email) || '' %>" style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;">
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem;">
          <a href="/admin/dashboard" class="btn-secondary">Cancel</a>
          <button type="submit" class="btn-primary">💾 Save Company Info</button>
        </div>

      </form>

    </div>

  </div>

</body>
</html>
