<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit <%= product.title %> | TechnoTherm Admin</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;700;800&family=Inter:wght@400;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/src/index.css">
</head>
<body style="background: #090d16; color: #fff;">

  <div style="background: #0d1322; border-bottom: 1px solid var(--border-subtle); padding: 1rem 0;">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
      <div style="font-weight: 800; font-size: 1.2rem;">Edit Product: <span style="color: var(--primary-orange-light);"><%= product.title %></span></div>
      <div>
        <a href="/admin/products" style="color: var(--text-muted); font-size: 0.9rem;">← Back to Products List</a>
      </div>
    </div>
  </div>

  <div class="container" style="padding: 2.5rem 0;">
    
    <div class="card-glass" style="padding: 2.5rem; max-width: 800px; margin: 0 auto; border: 1px solid var(--border-bright);">
      
      <form action="/admin/products/edit/<%= product.id %>" method="POST" enctype="multipart/form-data">
        
        <!-- Product Title -->
        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Product Title</label>
          <input 
            type="text" 
            name="title" 
            value="<%= product.title %>" 
            required
            style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;"
          >
        </div>

        <!-- Category & Badge Tag -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; margin-bottom: 1.25rem;">
          <div>
            <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Category</label>
            <select name="category" style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;">
              <option value="Heating Cables" <%= product.category === 'Heating Cables' ? 'selected' : '' %>>Heating Cables</option>
              <option value="Industrial Heaters" <%= product.category === 'Industrial Heaters' ? 'selected' : '' %>>Industrial Heaters</option>
              <option value="Insulation Jackets" <%= product.category === 'Insulation Jackets' ? 'selected' : '' %>>Insulation Jackets</option>
              <option value="Controls & Accessories" <%= product.category === 'Controls & Accessories' ? 'selected' : '' %>>Controls & Accessories</option>
              <option value="Turnkey & Consultancy" <%= product.category === 'Turnkey & Consultancy' ? 'selected' : '' %>>Turnkey & Consultancy</option>
            </select>
          </div>

          <div>
            <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Badge Tag</label>
            <input 
              type="text" 
              name="badge" 
              value="<%= product.badge %>" 
              style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;"
            >
          </div>
        </div>

        <!-- Image Upload Box -->
        <div style="margin-bottom: 1.5rem; background: rgba(255,87,34,0.06); padding: 1.25rem; border-radius: 8px; border: 1px solid rgba(255,87,34,0.25);">
          <label style="display: block; color: var(--primary-orange-light); font-size: 0.9rem; font-weight: 700; margin-bottom: 0.4rem;">
            📸 Product Image (Upload New Image)
          </label>
          
          <div style="display: flex; gap: 1.5rem; align-items: center; margin-bottom: 0.75rem;">
            <div style="width: 100px; height: 75px; border-radius: 6px; overflow: hidden; background: #000;">
              <img src="<%= product.images[0] %>" alt="Current image" style="width: 100%; height: 100%; object-fit: cover;">
            </div>
            <div style="font-size: 0.8rem; color: var(--text-muted);">
              Current Main Image. Uploading a new image will automatically fit it to the product card frame!
            </div>
          </div>

          <input 
            type="file" 
            name="productImage" 
            accept="image/*"
            style="width: 100%; padding: 0.5rem; background: rgba(9,13,22,0.8); color: #fff; border: 1px solid var(--border-subtle); border-radius: 6px;"
          >
          <div style="font-size: 0.75rem; color: var(--accent-green); margin-top: 0.4rem;">
            ✨ Automatic Image Normalization: Upload images of any size, aspect ratio, or resolution — the site automatically adjusts & crops them cleanly.
          </div>
        </div>

        <!-- Short Description -->
        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Short Summary Description</label>
          <input 
            type="text" 
            name="shortDesc" 
            value="<%= product.shortDesc %>" 
            required
            style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;"
          >
        </div>

        <!-- Full Overview Description -->
        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Full Overview Text</label>
          <textarea 
            name="fullDesc" 
            rows="4" 
            style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;"
          ><%= product.fullDesc %></textarea>
        </div>

        <!-- Bullet Features (One per line) -->
        <div style="margin-bottom: 1.25rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Key Bullet Features (One per line)</label>
          <textarea 
            name="features" 
            rows="4" 
            style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;"
          ><%= (product.features || []).join('\n') %></textarea>
        </div>

        <!-- Applications (One per line) -->
        <div style="margin-bottom: 1.75rem;">
          <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Industrial Applications (One per line)</label>
          <textarea 
            name="applications" 
            rows="3" 
            style="width: 100%; padding: 0.75rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;"
          ><%= (product.applications || []).join('\n') %></textarea>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem;">
          <a href="/admin/products" class="btn-secondary">Cancel</a>
          <button type="submit" class="btn-primary">💾 Save Product Changes</button>
        </div>

      </form>

    </div>

  </div>

</body>
</html>
