          <p class="section-subtext">Uses dynamic math parameters configured in your Admin Panel.</p>
        </div>

        <div class="card-glass" style="padding: 2.5rem; background: linear-gradient(135deg, rgba(19,27,46,0.95) 0%, rgba(13,20,35,0.98) 100%); border: 1px solid rgba(255,87,34,0.3);">
          <form id="heatCalcForm" style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 2.5rem; align-items: center;" class="calc-grid">
            <div>
              <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; margin-bottom: 1.5rem;">
                <div>
                  <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Nominal Pipe Diameter (NPS)</label>
                  <select id="calc_pipeDiameter" style="width: 100%; padding: 0.65rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;">
                    <option value="0.5">0.5 Inch (21.3 mm OD)</option>
                    <option value="1">1.0 Inch (33.4 mm OD)</option>
                    <option value="1.5">1.5 Inch (48.3 mm OD)</option>
                    <option value="2" selected>2.0 Inch (60.3 mm OD)</option>
                    <option value="3">3.0 Inch (88.9 mm OD)</option>
                    <option value="4">4.0 Inch (114.3 mm OD)</option>
                    <option value="6">6.0 Inch (168.3 mm OD)</option>
                    <option value="8">8.0 Inch (219.1 mm OD)</option>
                  </select>
                </div>

                <div>
                  <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Insulation Thickness (mm)</label>
                  <select id="calc_insulationThickness" style="width: 100%; padding: 0.65rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;">
                    <option value="25">25 mm Insulation</option>
                    <option value="38">38 mm Insulation</option>
                    <option value="50" selected>50 mm Insulation</option>
                    <option value="75">75 mm Insulation</option>
                    <option value="100">100 mm Insulation</option>
                  </select>
                </div>

                <div>
                  <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Maintain Temperature (°C)</label>
                  <input type="number" id="calc_maintainTemp" value="50" style="width: 100%; padding: 0.65rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;">
                </div>

                <div>
                  <label style="display: block; color: var(--text-muted); font-size: 0.85rem; font-weight: 600; margin-bottom: 0.4rem;">Min Ambient Temp (°C)</label>
                  <input type="number" id="calc_ambientTemp" value="0" style="width: 100%; padding: 0.65rem; background: rgba(9,13,22,0.8); border: 1px solid var(--border-subtle); color: #fff; border-radius: 6px;">
                </div>
              </div>

              <button type="button" onclick="runCalculation()" class="btn-primary" style="width: 100%; padding: 0.75rem;">
                Calculate Heat Loss (W/m)
              </button>
            </div>

            <!-- Output Display Box -->
            <div style="background: rgba(9,13,22,0.95); border: 1px solid var(--border-bright); padding: 2rem; border-radius: 14px; text-align: center; box-shadow: 0 10px 30px rgba(255,87,34,0.15);">
