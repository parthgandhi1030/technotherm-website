<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= data.companyDetails.name %> | Industrial Heating Cable & Thermal Solutions</title>
  
  <meta name="description" content="Leading manufacturer of Self-Regulating Heating Cables (SLSR), Constant Wattage Cable (CWSR), Energy Saving Insulation Jackets, Cold Storage Door Heaters & Turnkey Thermal Projects. ISO 9001:2015 Certified & CIMFR Approved.">
  <meta name="keywords" content="TechnoTherm Industries LLP, Self Regulating Heating Cable, SLSR Cable, Constant Wattage Heating Cable, CWSR Cable, Energy Saving Insulation Jacket, Silicone Rubber Drain Pipe Heater, Hopper Heating Pads, Industrial Drum Heaters, Turnkey Heat Tracing India">
  <link rel="canonical" href="https://teamthermotech.co.in/">

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <!-- Lucide Icons CDN -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* Complete Design System & High-Contrast CSS Rules */
    :root {
      --bg-dark: #090d16;
      --bg-card: #131b2e;
      --bg-card-hover: #1b2640;
      --bg-glass: rgba(19, 27, 46, 0.85);
      
      --primary-orange: #ff5722;
      --primary-orange-light: #ff784b;
      --accent-blue: #3b82f6;
      --accent-green: #10b981;
      
      --text-main: #f8fafc;
      --text-muted: #cbd5e1;
      --text-dim: #94a3b8;
      
      --border-subtle: rgba(255, 255, 255, 0.12);
      --border-bright: rgba(255, 87, 34, 0.4);
      
      --radius-sm: 8px;
      --radius-md: 14px;
      --radius-lg: 20px;
      --radius-full: 9999px;

      --shadow-sm: 0 4px 12px rgba(0, 0, 0, 0.3);
      --shadow-lg: 0 16px 40px rgba(0, 0, 0, 0.5);
      --shadow-orange: 0 8px 24px rgba(255, 87, 34, 0.25);
      
      --font-heading: 'Plus Jakarta Sans', -apple-system, sans-serif;
      --font-body: 'Inter', -apple-system, sans-serif;
    }

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      font-size: 16px;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: var(--font-body);
      line-height: 1.6;
      overflow-x: hidden;
      -webkit-font-smoothing: antialiased;
    }

    /* Reset Link Contrast & Prevent Purple/Blue Visited Browser Defaults */
    a, a:link, a:visited {
      color: inherit;
      text-decoration: none;
      transition: all 0.2s ease;
    }

    a:hover, a:focus {
      color: var(--primary-orange-light);
      text-decoration: none;
    }

    /* Force Pristine High Contrast for All Buttons Across All States */
    .btn-primary, .btn-primary:link, .btn-primary:visited {
      color: #ffffff !important;
    }

    .btn-primary:hover, .btn-primary:focus {
      color: #ffffff !important;
    }

    .btn-secondary, .btn-secondary:link, .btn-secondary:visited {
      color: #ffffff !important;
    }

    .btn-secondary:hover, .btn-secondary:focus {
      color: #ffffff !important;
    }

    .btn-outline-orange, .btn-outline-orange:link, .btn-outline-orange:visited {
      color: var(--primary-orange-light) !important;
    }

    .btn-outline-orange:hover, .btn-outline-orange:focus {
      color: #ffffff !important;
      background: var(--primary-orange);
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: var(--font-heading);
      font-weight: 700;
      line-height: 1.25;
      color: #ffffff;
    }

    button {
      font-family: var(--font-heading);
      cursor: pointer;
      border: none;
      outline: none;
      background: none;
    }

    .container {
      width: 100%;
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 1.5rem;
    }

    .section {
      padding: 5rem 0;
      position: relative;
    }

    .section-title-wrapper {
      text-align: center;
      max-width: 760px;
      margin: 0 auto 3.5rem auto;
    }

    .badge-tag {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.9rem;
      border-radius: var(--radius-full);
      font-size: 0.825rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      background: rgba(255, 87, 34, 0.15);
      color: var(--primary-orange-light);
      border: 1px solid rgba(255, 87, 34, 0.3);
      margin-bottom: 0.75rem;
    }

    .section-heading {
      font-size: 2.5rem;
      color: #ffffff;
      margin-bottom: 1rem;
    }

    .section-heading span {
      background: linear-gradient(135deg, var(--primary-orange) 0%, #ff9800 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .section-subtext {
      font-size: 1.1rem;
      color: var(--text-muted);
    }

    /* Glassmorphic Cards */
    .card-glass {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-sm);
      transition: all 0.25s ease;
    }

    .card-glass:hover {
      border-color: var(--border-bright);
      transform: translateY(-4px);
      box-shadow: var(--shadow-orange);
    }

    /* Buttons */
    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      background: linear-gradient(135deg, var(--primary-orange) 0%, #e64a19 100%);
      color: #ffffff !important;
      padding: 0.85rem 1.8rem;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 1rem;
      box-shadow: 0 4px 14px rgba(255, 87, 34, 0.4);
      transition: all 0.25s ease;
    }

    .btn-primary:hover {
      background: linear-gradient(135deg, #ff7043 0%, var(--primary-orange) 100%);
      box-shadow: 0 6px 20px rgba(255, 87, 34, 0.6);
      transform: translateY(-2px);
    }

    .btn-secondary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      background: rgba(255, 255, 255, 0.08);
      color: #ffffff !important;
      border: 1px solid var(--border-subtle);
      padding: 0.85rem 1.8rem;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 1rem;
      transition: all 0.25s ease;
    }

    .btn-secondary:hover {
      background: rgba(255, 255, 255, 0.15);
      border-color: rgba(255, 255, 255, 0.3);
      transform: translateY(-2px);
    }

    .btn-outline-orange {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      border: 1px solid var(--primary-orange);
      color: var(--primary-orange-light) !important;
      padding: 0.6rem 1.2rem;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 0.9rem;
    }

    .btn-outline-orange:hover {
      background: var(--primary-orange);
      color: #fff !important;
    }

    /* Aspect ratio image frame normalization */
    .img-auto-fit {
      width: 100%;
      height: 220px;
      object-fit: cover;
      object-position: center;
      transition: transform 0.4s ease;
    }
    .img-auto-fit:hover {
      transform: scale(1.05);
    }

    @media (max-width: 992px) {
      .hero-grid, .about-cards-grid, .products-grid, .calc-grid, .roi-grid, .explorer-grid, .turnkey-grid, .industries-grid, .contact-grid {
        grid-template-columns: 1fr !important;
      }
      .desktop-nav {
        display: none !important;
      }
    }
  </style>
</head>
<body>

  <!-- Sticky Header -->
  <header style="position: fixed; top: 0; left: 0; right: 0; z-index: 1000;">
    <!-- Top Announcement Bar -->
    <div style="background: #070a12; border-bottom: 1px solid var(--border-subtle); padding: 0.4rem 0; font-size: 0.85rem; color: var(--text-muted);">
      <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
        <div style="display: flex; align-items: center; gap: 1.2rem; flex-wrap: wrap;">
          <span style="display: flex; align-items: center; gap: 0.35rem; color: var(--text-muted);">
            <i data-lucide="shield-check" style="width: 14px; height: 14px; color: var(--primary-orange);"></i> ISO 9001:2015 & CSIR-CIMFR Certified
          </span>
          <span style="display: flex; align-items: center; gap: 0.35rem; color: var(--text-muted);">
            <i data-lucide="map-pin" style="width: 14px; height: 14px; color: var(--accent-blue);"></i> Vasai (E), Palghar, Maharashtra (India)
          </span>
        </div>
        <div style="display: flex; align-items: center; gap: 1.2rem;">
          <a href="tel:<%= data.companyDetails.contact.phones[0] %>" style="display: flex; align-items: center; gap: 0.35rem; color: #ffffff;">
            <i data-lucide="phone" style="width: 14px; height: 14px; color: var(--primary-orange);"></i> <%= data.companyDetails.contact.phones[0] %>
          </a>
          <a href="mailto:<%= data.companyDetails.contact.email %>" style="display: flex; align-items: center; gap: 0.35rem; color: var(--primary-orange-light);">
            <i data-lucide="mail" style="width: 14px; height: 14px; color: var(--accent-blue);"></i> <%= data.companyDetails.contact.email %>
          </a>
          <a href="/admin/login" style="color: var(--accent-blue); font-weight: 600; display: flex; align-items: center; gap: 0.3rem;">
            <i data-lucide="lock" style="width: 14px; height: 14px;"></i> Admin Panel
          </a>
        </div>
      </div>
    </div>

    <!-- Main Navigation Bar -->
    <nav style="background: rgba(9, 13, 22, 0.95); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border-subtle); padding: 0.9rem 0;">
      <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
        <a href="#hero" style="display: flex; align-items: center; gap: 0.75rem; color: #ffffff;">
          <div style="width: 42px; height: 42px; border-radius: 10px; background: linear-gradient(135deg, var(--primary-orange) 0%, #d84315 100%); display: flex; align-items: center; justify-content: center; color: #fff; box-shadow: 0 4px 12px rgba(255, 87, 34, 0.4);">
            <i data-lucide="flame" style="width: 26px; height: 26px;"></i>
          </div>
          <div>
            <div style="font-family: var(--font-heading); font-weight: 800; font-size: 1.35rem; color: #ffffff; line-height: 1;">
              Techno<span style="color: var(--primary-orange);">Therm</span>
            </div>
            <div style="font-size: 0.7rem; color: var(--text-muted); letter-spacing: 0.08em; text-transform: uppercase;">
              Industries LLP • Est. 1971
            </div>
          </div>
        </a>

        <!-- Desktop Navigation Items -->
        <div style="display: flex; align-items: center; gap: 1.3rem;" class="desktop-nav">
          <a href="#hero" style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">Home</a>
          <a href="#about" style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">About Us</a>
          <a href="#products" style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">Products</a>
          <a href="#cable-explorer" style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">Cable Explorer</a>
          <a href="#calculator" style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">Heat Calculator</a>
          <a href="#roi-calculator" style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">ROI Calculator</a>
          <a href="#turnkey" style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">Turnkey</a>
          <a href="#references" style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">References</a>
          <a href="#contact" style="font-size: 0.9rem; font-weight: 500; color: var(--text-muted);">Contact</a>
        </div>

        <a href="#contact" class="btn-primary" style="padding: 0.65rem 1.25rem; font-size: 0.875rem;">
          <i data-lucide="file-text" style="width: 16px; height: 16px;"></i> Request Quote
        </a>
      </div>
    </nav>
  </header>

  <!-- MAIN CONTENT -->
  <main style="padding-top: 130px;">
    
    <!-- Hero Section -->
    <section id="hero" style="padding: 90px 0; background: radial-gradient(circle at 70% 30%, rgba(255, 87, 34, 0.15) 0%, rgba(9, 13, 22, 1) 70%);">
      <div class="container">
        <div style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 3.5rem; align-items: center;" class="hero-grid">
          <div>
            <div class="badge-tag">
              <i data-lucide="shield-check" style="width: 16px; height: 16px;"></i> ISO 9001:2015 & CSIR-CIMFR Certified
            </div>

            <h1 style="font-size: 3.2rem; font-weight: 800; color: #ffffff; line-height: 1.15; margin-bottom: 1.25rem; letter-spacing: -0.03em;">
              Precision Industrial <br>
              <span style="background: linear-gradient(135deg, #ff5722 0%, #ff9800 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">
                Electric Heating Cables
              </span> & Thermal Systems
            </h1>

            <p style="font-size: 1.15rem; color: var(--text-muted); margin-bottom: 2rem; max-width: 620px; line-height: 1.6;">
              Over 53 years of engineering trust since 1971. Manufacturing Self-Regulating (SLSR) & Constant Wattage (CWSR) Heating Cables, Power Saving Insulation Jackets, Cold Storage Door Heaters, Hopper Pads, and Turnkey Solutions.
            </p>

            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 0.75rem; margin-bottom: 2.5rem;">
              <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted); font-size: 0.95rem;">
                <i data-lucide="check-circle-2" style="width: 18px; height: 18px; color: var(--primary-orange);"></i> 20%-45% Energy Saving Jackets
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted); font-size: 0.95rem;">
                <i data-lucide="check-circle-2" style="width: 18px; height: 18px; color: var(--primary-orange);"></i> Zone II Ex Area CIMFR Certified
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted); font-size: 0.95rem;">
                <i data-lucide="check-circle-2" style="width: 18px; height: 18px; color: var(--primary-orange);"></i> Custom Lengths & Sizing Support
              </div>
              <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--text-muted); font-size: 0.95rem;">
                <i data-lucide="check-circle-2" style="width: 18px; height: 18px; color: var(--primary-orange);"></i> Exports to 12+ Nations Worldwide
              </div>
            </div>

            <div style="display: flex; gap: 1rem; flex-wrap: wrap;">
              <a href="#products" class="btn-primary">
                Explore Product Line <i data-lucide="arrow-right" style="width: 18px; height: 18px;"></i>
              </a>
              <a href="#calculator" class="btn-secondary">
                <i data-lucide="calculator" style="width: 18px; height: 18px; color: var(--primary-orange);"></i> Calculate Cable Heat Loss
              </a>
            </div>
          </div>

          <!-- Hero Graphic Card -->
          <div>
            <div class="card-glass" style="padding: 2rem; border: 1px solid rgba(255,87,34,0.3); box-shadow: 0 20px 50px rgba(0,0,0,0.6);">
              <div style="position: relative; border-radius: 12px; overflow: hidden; margin-bottom: 1.5rem; height: 260px; background: #000;">
                <img src="/assets/images/slsr_cable_1.jpg" alt="TechnoTherm Heating Cables" class="img-auto-fit" style="height: 100%;">
                <div style="position: absolute; inset: 0; background: linear-gradient(to top, rgba(9,13,22,0.95) 0%, transparent 60%); display: flex; align-items: flex-end; padding: 1.25rem;">
                  <div>
                    <span class="badge-tag" style="background: var(--primary-orange); color: #fff; border: none;">
                      THERMO-FLEX® SLSR Series
                    </span>
                    <h3 style="color: #fff; font-size: 1.25rem; margin-top: 0.25rem;">
                      Self-Regulating Electric Heat Tracer
                    </h3>
                  </div>
                </div>
              </div>

              <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; background: rgba(255,255,255,0.03); padding: 1rem; border-radius: 10px;">
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-dim);">Temperature Range</div>
                  <div style="font-weight: 700; color: #fff; font-size: 1rem;">-60°C to +220°C</div>
                </div>
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-dim);">Wattage Ratings</div>
                  <div style="font-weight: 700; color: var(--primary-orange-light); font-size: 1rem;">10W - 60W / meter</div>
                </div>
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-dim);">Hazardous Rating</div>
                  <div style="font-weight: 700; color: #fff; font-size: 1rem;">Zone II (T1 to T5)</div>
                </div>
                <div>
                  <div style="font-size: 0.8rem; color: var(--text-dim);">Certifications</div>
                  <div style="font-weight: 700; color: var(--accent-green); font-size: 1rem;">CIMFR / ISO 9001</div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Key Stats Bar -->
        <div style="margin-top: 4.5rem; display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem; background: rgba(19, 27, 46, 0.6); border: 1px solid var(--border-subtle); border-radius: var(--radius-md); padding: 2rem; backdrop-filter: blur(10px);">
          <div style="text-align: center;">
            <div style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--primary-orange-light); line-height: 1;">53+</div>
            <div style="font-weight: 600; color: #fff; margin-top: 0.35rem;">Years Group Legacy</div>
            <div style="font-size: 0.825rem; color: var(--text-dim);">Est. 1971</div>
          </div>
          <div style="text-align: center;">
            <div style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--primary-orange-light); line-height: 1;">5,000+</div>
            <div style="font-weight: 600; color: #fff; margin-top: 0.35rem;">Projects Completed</div>
            <div style="font-size: 0.825rem; color: var(--text-dim);">Worldwide</div>
          </div>
          <div style="text-align: center;">
            <div style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--primary-orange-light); line-height: 1;">15+</div>
            <div style="font-weight: 600; color: #fff; margin-top: 0.35rem;">Product Lines</div>
            <div style="font-size: 0.825rem; color: var(--text-dim);">Custom & Standard</div>
          </div>
          <div style="text-align: center;">
            <div style="font-family: var(--font-heading); font-size: 2.5rem; font-weight: 800; color: var(--primary-orange-light); line-height: 1;">12+</div>
            <div style="font-weight: 600; color: #fff; margin-top: 0.35rem;">Export Destinations</div>
            <div style="font-size: 0.825rem; color: var(--text-dim);">Global Footprint</div>
          </div>
        </div>
      </div>
    </section>

    <!-- About Section -->
    <section id="about" class="section" style="background: #0b101d;">
      <div class="container">
        <div class="section-title-wrapper">
          <div class="badge-tag">
            <i data-lucide="award" style="width: 16px; height: 16px;"></i> Over 5 Decades of Engineering Trust
          </div>
          <h2 class="section-heading">About <span><%= data.companyDetails.name %></span></h2>
          <p class="section-subtext">A proud group company of Thermo-Tech Industries with a continuous legacy of quality, innovation, and reliability in thermal management solutions since 1971.</p>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; margin-bottom: 4rem;" class="about-cards-grid">
          <div class="card-glass" style="padding: 2rem;">
            <h3 style="color: #fff; font-size: 1.3rem; margin-bottom: 0.75rem;">Our Vision</h3>
            <p style="color: var(--text-muted); font-size: 0.975rem; line-height: 1.6;"><%= data.companyDetails.vision %></p>
          </div>
          <div class="card-glass" style="padding: 2rem;">
            <h3 style="color: #fff; font-size: 1.3rem; margin-bottom: 0.75rem;">Our Mission</h3>
            <p style="color: var(--text-muted); font-size: 0.975rem; line-height: 1.6;"><%= data.companyDetails.mission %></p>
          </div>
          <div class="card-glass" style="padding: 2rem;">
            <h3 style="color: #fff; font-size: 1.3rem; margin-bottom: 0.75rem;">Our Core Value</h3>
            <p style="color: var(--text-muted); font-size: 0.975rem; line-height: 1.6;"><%= data.companyDetails.coreValue %></p>
          </div>
        </div>

        <!-- Chairman Message -->
        <div class="card-glass" style="padding: 2.5rem; background: linear-gradient(135deg, rgba(19,27,46,0.9) 0%, rgba(13,20,35,0.95) 100%); border: 1px solid rgba(255,87,34,0.3);">
          <div style="display: grid; grid-template-columns: auto 1fr; gap: 2rem; align-items: start;" class="chairman-grid">
            <div style="text-align: center;">
              <div style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, var(--primary-orange) 0%, #ff9800 100%); display: flex; align-items: center; justify-content: center; color: #fff; font-size: 2.5rem; font-weight: 800; margin: 0 auto 1rem auto; box-shadow: 0 8px 24px rgba(255,87,34,0.4);">
                RG
              </div>
              <h4 style="color: #fff; font-size: 1.2rem; margin: 0;"><%= data.companyDetails.chairman.name %></h4>
              <div style="color: var(--primary-orange-light); font-size: 0.875rem; font-weight: 600;"><%= data.companyDetails.chairman.title %></div>
              <div style="font-size: 0.8rem; color: var(--text-dim);">TechnoTherm Industries LLP</div>
            </div>

            <div>
              <div style="display: flex; align-items: center; gap: 0.5rem; color: var(--primary-orange); margin-bottom: 0.75rem;">
                <i data-lucide="quote" style="width: 24px; height: 24px;"></i>
                <span style="font-weight: 700; font-size: 1.1rem; text-transform: uppercase; letter-spacing: 0.05em;">Chairman's Address</span>
              </div>

              <blockquote style="font-size: 1.1rem; font-style: italic; color: #f1f5f9; line-height: 1.6; margin-bottom: 1.25rem;">
                "<%= data.companyDetails.chairman.quote %>"
              </blockquote>

              <div id="chairmanShortMsg" style="color: var(--text-muted); line-height: 1.7; font-size: 0.975rem;">
