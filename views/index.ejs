    <!-- Heat Calculator Section -->
    <section id="calculator" class="section" style="background: #0b101d;">
      <div class="container">
        <div class="section-title-wrapper">
          <div class="badge-tag">
            <i data-lucide="calculator" style="width: 16px; height: 16px;"></i> Dynamic Formula Calculator
          </div>
