              </div>
              <div id="res_recommendedCable" style="color: #fff; font-weight: 700; font-size: 0.95rem; margin-bottom: 1.5rem;">
                SLSR-35 (Self-Regulating 35W/m)
              </div>
              <a href="/admin/calculator-settings" style="color: var(--accent-blue); font-size: 0.85rem; font-weight: 600; display: inline-flex; align-items: center; gap: 0.3rem;">
                ⚙️ Adjust Formula & Safety Factor in Admin Panel
              </a>
            </div>
          </form>
        </div>
      </div>
    </section>

