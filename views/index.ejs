                  <button type="button" onclick="handleWhatsAppSend()" class="btn-secondary" style="color: #25D366 !important; border-color: rgba(37, 211, 102, 0.3); display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                    <i data-lucide="message-square" style="width: 16px; height: 16px;"></i> WhatsApp RFQ
