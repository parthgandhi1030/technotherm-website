  <!-- Product Specification Tech Sheet Modal -->
  <div id="productModal" style="display: none; position: fixed; inset: 0; z-index: 2000; background: rgba(5, 8, 15, 0.85); backdrop-filter: blur(10px); align-items: center; justify-content: center; padding: 1.5rem;">
    <div class="card-glass animate-fade-in" style="width: 100%; max-width: 900px; max-height: 90vh; overflow-y: auto; position: relative; padding: 2.5rem; background: #0d1322; border: 1px solid var(--border-bright); box-shadow: 0 25px 60px rgba(0,0,0,0.8);">
      <button onclick="closeProductModal()" style="position: absolute; top: 20px; right: 20px; background: rgba(255,255,255,0.08); color: #fff; width: 36px; height: 36px; border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; border: none;">
        <i data-lucide="x" style="width: 20px; height: 20px;"></i>
      </button>
      <div id="modalContent"></div>
    </div>
  </div>

  <script>
    // Initialize Lucide icons
    lucide.createIcons();

    const productsData = <%- JSON.stringify(data.productCategories || []) %>;

    // ================= 1. CHAIRMAN ADDRESS READ MORE TOGGLE =================
    let chairmanExpanded = false;
    function toggleChairmanMsg() {
      chairmanExpanded = !chairmanExpanded;
      const shortEl = document.getElementById('chairmanShortMsg');
      const fullEl = document.getElementById('chairmanFullMsg');
      const btnText = document.getElementById('chairmanBtnText');
      const btnIcon = document.getElementById('chairmanBtnIcon');

      if (chairmanExpanded) {
        shortEl.style.display = 'none';
        fullEl.style.display = 'block';
        btnText.innerText = 'Read Less';
        btnIcon.setAttribute('data-lucide', 'chevron-up');
      } else {
        shortEl.style.display = 'block';
        fullEl.style.display = 'none';
        btnText.innerText = 'Read Full Chairman Message';
        btnIcon.setAttribute('data-lucide', 'chevron-down');
      }
      lucide.createIcons();
    }

    // ================= 2. PRODUCT CATEGORY FILTERS & SEARCH =================
    let activeCategory = 'All';
    function filterCategory(cat, btn) {
      activeCategory = cat;
      document.querySelectorAll('.cat-filter-btn').forEach(b => {
        b.style.background = 'rgba(255,255,255,0.05)';
        b.style.color = 'var(--text-muted)';
        b.style.border = '1px solid var(--border-subtle)';
      });
      btn.style.background = 'var(--primary-orange)';
      btn.style.color = '#fff';
      btn.style.border = 'none';

      applyProductFilters();
    }

    function handleProductSearch() {
      applyProductFilters();
    }

    function applyProductFilters() {
      const query = document.getElementById('productSearchInput').value.toLowerCase().trim();
      const items = document.querySelectorAll('.product-card-item');

      items.forEach(item => {
        const itemCat = item.getAttribute('data-category');
        const itemTitle = item.getAttribute('data-title');
        const itemDesc = item.getAttribute('data-desc');

        const matchesCat = (activeCategory === 'All' || itemCat === activeCategory);
        const matchesQuery = (!query || itemTitle.includes(query) || itemDesc.includes(query));

        if (matchesCat && matchesQuery) {
          item.style.display = 'flex';
        } else {
          item.style.display = 'none';
        }
      });
    }

    // ================= 3. PRODUCT COMPARE FUNCTIONALITY =================
    let selectedCompareIds = [];

    function toggleCompareProduct(productId) {
      const idx = selectedCompareIds.indexOf(productId);
      const btn = document.getElementById('compare_btn_' + productId);
      const icon = document.getElementById('compare_icon_' + productId);
      const text = document.getElementById('compare_text_' + productId);

      if (idx > -1) {
        selectedCompareIds.splice(idx, 1);
        btn.style.background = 'rgba(9,13,22,0.85)';
        icon.style.color = 'transparent';
        text.innerText = '+ Compare';
      } else {
        selectedCompareIds.push(productId);
        btn.style.background = 'var(--primary-orange)';
        icon.style.color = '#fff';
        text.innerText = 'Compared';
      }

      updateCompareBar();
    }

    function updateCompareBar() {
      const bar = document.getElementById('floatingCompareBar');
      const barText = document.getElementById('compareBarText');
      if (selectedCompareIds.length > 0) {
        bar.style.display = 'flex';
        barText.innerText = selectedCompareIds.length + ' Product(s) Selected for Side-by-Side Comparison';
      } else {
        bar.style.display = 'none';
      }
    }

    function clearProductCompare() {
      selectedCompareIds.forEach(id => {
        const btn = document.getElementById('compare_btn_' + id);
        const icon = document.getElementById('compare_icon_' + id);
        const text = document.getElementById('compare_text_' + id);
        if (btn) {
          btn.style.background = 'rgba(9,13,22,0.85)';
          icon.style.color = 'transparent';
          text.innerText = '+ Compare';
        }
      });
      selectedCompareIds = [];
      updateCompareBar();
    }

    function openCompareModal() {
      const compareProducts = productsData.filter(p => selectedCompareIds.includes(p.id));
      if (compareProducts.length === 0) return;

      const content = `
        <div style="margin-bottom: 1.5rem;">
          <span class="badge-tag"><i data-lucide="zap" style="width: 14px; height: 14px;"></i> Side-by-Side Comparison</span>
          <h2 style="font-size: 1.8rem; color: #fff; margin-top: 0.25rem;">Product Technical Comparison Matrix</h2>
        </div>

        <div style="overflow-x: auto; margin-bottom: 1.5rem;">
          <table style="width: 100%; border-collapse: collapse; font-size: 0.9rem;">
            <thead>
              <tr style="border-bottom: 2px solid var(--border-subtle);">
                <th style="padding: 1rem; width: 22%; color: var(--text-muted); text-align: left;">Technical Spec</th>
                ${compareProducts.map(prod => `
                  <th style="padding: 1rem; text-align: center;">
                    <div style="width: 80px; height: 60px; margin: 0 auto 0.5rem auto; border-radius: 6px; overflow: hidden;">
                      <img src="${prod.images[0]}" alt="${prod.title}" style="width: 100%; height: 100%; object-fit: cover;">
                    </div>
                    <div style="color: #fff; font-size: 1rem; font-weight: 700;">${prod.title}</div>
                    <div style="font-size: 0.75rem; color: var(--primary-orange-light); margin-top: 0.25rem;">${prod.badge || ''}</div>
                  </th>
                `).join('')}
              </tr>
            </thead>
            <tbody>
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: 0.85rem 1rem; color: var(--text-muted); font-weight: 600;">Category</td>
                ${compareProducts.map(p => `<td style="padding: 0.85rem 1rem; text-align: center; color: #fff;">${p.category}</td>`).join('')}
              </tr>
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: 0.85rem 1rem; color: var(--text-muted); font-weight: 600;">Heat Output Behavior</td>
                ${compareProducts.map(p => `<td style="padding: 0.85rem 1rem; text-align: center; color: #cbd5e1;">${p.id.includes('slsr') ? 'Automatically varies with ambient temp' : 'Constant / fixed output per meter'}</td>`).join('')}
              </tr>
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: 0.85rem 1rem; color: var(--text-muted); font-weight: 600;">Overheating Protection</td>
                ${compareProducts.map(p => `<td style="padding: 0.85rem 1rem; text-align: center; color: #cbd5e1;">${p.id.includes('slsr') ? 'Intrinsic self-regulating polymer core' : 'Requires control thermostat / PID panel'}</td>`).join('')}
              </tr>
              <tr style="border-bottom: 1px solid var(--border-subtle);">
                <td style="padding: 0.85rem 1rem; color: var(--text-muted); font-weight: 600;">Short Summary</td>
                ${compareProducts.map(p => `<td style="padding: 0.85rem 1rem; text-align: center; color: #94a3b8; font-size: 0.85rem;">${p.shortDesc}</td>`).join('')}
              </tr>
            </tbody>
          </table>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem; padding-top: 1rem;">
          <button onclick="closeProductModal()" class="btn-secondary">Close Comparison</button>
        </div>
      `;

      document.getElementById('modalContent').innerHTML = content;
      document.getElementById('productModal').style.display = 'flex';
      lucide.createIcons();
    }

    // ================= 4. CABLE STRUCTURE EXPLORER INTERACTION =================
    const slsrLayers = [
      { name: "1. Bus Conductors", material: "Dual Tinned Copper Wires (7 × 0.4 mm)", desc: "Delivers continuous electrical power along the entire circuit length with high electrical conductivity and corrosion resistance.", color: "#f59e0b" },
      { name: "2. PTC Semi-Conductive Core", material: "PTC Carbon Matrix Polymer", desc: "The heart of Self-Regulating technology. Semi-conductive polymer matrix automatically increases resistance when hot and decreases resistance when cold.", color: "#ef4444" },
      { name: "3. Primary Insulation", material: "Polyolefin / Fluoropolymer (PTFE)", desc: "High dielectric strength insulation layer protecting against moisture, thermal stress, and voltage breakdown up to 220V/230V AC.", color: "#3b82f6" },
      { name: "4. Metallic Shield Braid", material: "Aluminium-Magnesium Alloy Braid", desc: "Provides 100% ground fault safety protection, mechanical impact resistance, and electromagnetic shielding as required by IS/IEC standards.", color: "#94a3b8" },
      { name: "5. Outer Protective Jacket", material: "UV-Resistant Polyolefin / FEP", desc: "Heavy-duty outer sheath protecting against harsh industrial chemicals, weather exposure, UV radiation, and mechanical abrasion.", color: "#1e293b" }
    ];

    const cwsrLayers = [
      { name: "1. Resistance Heating Element", material: "Nichrome / PTFE Teflon Coated Series Wire", desc: "Delivers constant, non-varying wattage per meter (25W/m or 45W/m) regardless of temperature changes.", color: "#f97316" },
      { name: "2. Primary Insulation", material: "P.T.F.E. (Teflon) High-Temp Matrix", desc: "Continuous high-temperature insulation rated for non-energized exposure up to 200°C.", color: "#60a5fa" },
      { name: "3. Secondary Insulation", material: "High-Purity Glass-Fibre Braid", desc: "Secondary thermal barrier providing extreme mechanical stability under continuous heat load.", color: "#e2e8f0" },
      { name: "4. Protective Metallic Sheathing", material: "SS 304 Stainless Steel Sheath Braid", desc: "Robust stainless steel outer casing certified for Zone II explosive gas environments (CSIR-CIMFR Approved).", color: "#cbd5e1" }
    ];

    let activeCableType = 'SLSR';
    let selectedLayerIndex = 0;
    let heatGlowActive = true;

    function renderCableLayers() {
      const layers = activeCableType === 'SLSR' ? slsrLayers : cwsrLayers;
      const stackEl = document.getElementById('cableLayersStack');
      if (!stackEl) return;

      const titleEl = document.getElementById('explorerSectionTitle');
      if (titleEl) {
        titleEl.innerText = activeCableType === 'SLSR' ? 'SLSR PTC Cross-Section Construction' : 'CWSR Series Tracer Cross-Section';
      }

      stackEl.innerHTML = layers.map((layer, idx) => {
        const isSelected = idx === selectedLayerIndex;
        const bg = isSelected ? 'rgba(255,87,34,0.15)' : 'rgba(255,255,255,0.03)';
        const border = isSelected ? '2px solid var(--primary-orange)' : '1px solid var(--border-subtle)';
        const glow = (isSelected && heatGlowActive) ? `box-shadow: 0 0 20px rgba(255,87,34,0.4);` : '';

        return `
          <div 
            onclick="selectCableLayer(${idx})" 
            style="padding: 1rem 1.25rem; border-radius: var(--radius-sm); background: ${bg}; border: ${border}; cursor: pointer; transition: all 0.2s; ${glow} display: flex; align-items: center; justify-content: space-between;"
          >
            <div style="display: flex; align-items: center; gap: 1rem;">
              <div style="width: 16px; height: 16px; border-radius: 50%; background: ${layer.color}; boxShadow: ${heatGlowActive ? `0 0 10px ${layer.color}` : 'none'};"></div>
              <div>
                <div style="color: ${isSelected ? '#fff' : 'var(--text-main)'}; font-weight: 700; font-size: 0.95rem;">
                  ${layer.name}
                </div>
                <div style="font-size: 0.8rem; color: var(--text-muted);">
                  ${layer.material}
                </div>
              </div>
            </div>
            ${isSelected ? '<div style="color: var(--primary-orange-light); font-size: 0.8rem; font-weight: 700; text-transform: uppercase;">Selected</div>' : ''}
          </div>
        `;
      }).join('');

      // Update Right Detail Card
      const currentLayer = layers[selectedLayerIndex] || layers[0];
      document.getElementById('specLayerName').innerText = currentLayer.name;
      document.getElementById('specLayerMaterial').innerText = 'Material: ' + currentLayer.material;
      document.getElementById('specLayerDesc').innerText = currentLayer.desc;
    }

    function selectCableLayer(idx) {
      selectedLayerIndex = idx;
      renderCableLayers();
    }

    function switchCableType(type) {
      activeCableType = type;
      selectedLayerIndex = 0;
      
      const btnSLSR = document.getElementById('cableTypeSLSR');
      const btnCWSR = document.getElementById('cableTypeCWSR');

      if (type === 'SLSR') {
        btnSLSR.className = 'btn-primary';
        btnCWSR.className = 'btn-secondary';
      } else {
        btnSLSR.className = 'btn-secondary';
        btnCWSR.className = 'btn-primary';
      }

      renderCableLayers();
    }

    function toggleHeatGlow() {
      heatGlowActive = !heatGlowActive;
      const statusEl = document.getElementById('heatGlowStatus');
      const btn = document.getElementById('heatGlowBtn');

      if (heatGlowActive) {
        statusEl.innerText = 'ON';
        btn.style.background = 'rgba(255,87,34,0.2)';
        btn.style.borderColor = 'var(--primary-orange)';
        btn.style.color = 'var(--primary-orange-light)';
      } else {
        statusEl.innerText = 'OFF';
        btn.style.background = 'rgba(255,255,255,0.05)';
        btn.style.borderColor = 'var(--border-subtle)';
        btn.style.color = 'var(--text-muted)';
      }

      renderCableLayers();
    }

    // Initialize Cable Explorer cutaway stack on load
    window.addEventListener('DOMContentLoaded', () => {
      renderCableLayers();
    });

    // ================= 5. PRODUCT TECH SHEET MODAL & CALCULATOR FUNCTIONS =================
    function openProductModal(productId) {
      const product = productsData.find(p => p.id === productId);
      if (!product) return;
      
      const content = `
        <div style="margin-bottom: 1.5rem;">
          <span class="badge-tag"><i data-lucide="shield-check" style="width: 14px; height: 14px;"></i> ${product.category}</span>
          <h2 style="font-size: 1.8rem; color: #fff; margin-top: 0.5rem;">${product.title}</h2>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-bottom: 2rem;" class="modal-top-grid">
          <div>
            <div style="border-radius: 12px; overflow: hidden; height: 260px; background: #000; margin-bottom: 0.75rem;">
              <img src="${product.images[0]}" alt="${product.title}" style="width: 100%; height: 100%; object-fit: contain;">
            </div>
          </div>
          <div>
            <h4 style="color: #fff; margin-bottom: 0.5rem; font-size: 1.1rem;">Product Overview</h4>
            <p style="color: var(--text-muted); font-size: 0.925rem; line-height: 1.6; margin-bottom: 1.25rem;">
              ${product.fullDesc}
            </p>
            <h5 style="color: #fff; font-size: 0.95rem; margin-bottom: 0.5rem;">Key Technical Features</h5>
            <ul style="list-style: none; display: flex; flex-direction: column; gap: 0.35rem; color: #cbd5e1; font-size: 0.875rem;">
              ${(product.features || []).map(f => `<li style="display: flex; align-items: center; gap: 0.4rem;"><i data-lucide="check" style="width: 14px; height: 14px; color: var(--primary-orange);"></i> ${f}</li>`).join('')}
            </ul>
          </div>
        </div>

        <div style="display: flex; justify-content: flex-end; gap: 1rem; padding-top: 1.5rem; border-top: 1px solid var(--border-subtle);">
          <button onclick="closeProductModal()" class="btn-secondary">Close</button>
          <a href="#contact" onclick="closeProductModal(); selectProductForInquiry('${product.title}')" class="btn-primary">Request Sizing RFQ →</a>
        </div>
      `;

      document.getElementById('modalContent').innerHTML = content;
      document.getElementById('productModal').style.display = 'flex';
      lucide.createIcons();
    }

    function closeProductModal() {
      document.getElementById('productModal').style.display = 'none';
    }

    function selectProductForInquiry(productTitle) {
      const selectEl = document.getElementById('contact_product');
      if (selectEl) {
        selectEl.value = productTitle;
      }
    }

    async function runCalculation() {
      const payload = {
        pipeDiameter: document.getElementById('calc_pipeDiameter').value,
        insulationThickness: document.getElementById('calc_insulationThickness').value,
        maintainTemp: document.getElementById('calc_maintainTemp').value,
        ambientTemp: document.getElementById('calc_ambientTemp').value,
        pipeLength: 30,
        insulationType: 'glasswool'
      };

      try {
        const res = await fetch('/api/calculate-heat-loss', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await res.json();
        document.getElementById('res_qPerMeter').innerHTML = data.qPerMeter + ' <span style="font-size: 1.2rem; color: var(--text-muted);">W/m</span>';
        document.getElementById('res_recommendedCable').innerText = data.recommendedCable;
      } catch (e) {
        console.error(e);
      }
    }

    function runRoiCalc() {
      const machines = parseFloat(document.getElementById('roi_machines').value) || 1;
      const kw = parseFloat(document.getElementById('roi_kw').value) || 10;
      const hrs = parseFloat(document.getElementById('roi_hrs').value) || 12;
      const tariff = parseFloat(document.getElementById('roi_tariff').value) || 10;

      const dailyKwh = machines * kw * hrs * 0.35;
      const monthlyKwh = Math.round(dailyKwh * 30);
      const annualSavings = Math.round(monthlyKwh * 12 * tariff);

      document.getElementById('res_roiSavings').innerText = '₹' + annualSavings.toLocaleString();
      document.getElementById('res_roiKwh').innerText = monthlyKwh.toLocaleString() + ' kWh';
    }

    function handleContactSubmit(e) {
      e.preventDefault();
      const name = document.getElementById('contact_name').value;
      const company = document.getElementById('contact_company').value;
      const email = document.getElementById('contact_email').value;
      const phone = document.getElementById('contact_phone').value;
      const product = document.getElementById('contact_product').value;
      const message = document.getElementById('contact_msg').value;

      const subject = encodeURIComponent(`Inquiry for ${product} - ${company}`);
      const body = encodeURIComponent(`Name: ${name}\nCompany: ${company}\nPhone: ${phone}\nEmail: ${email}\nProduct: ${product}\n\nDetails:\n${message}`);
      window.location.href = `mailto:<%= data.companyDetails.contact.email %>?subject=${subject}&body=${body}`;
    }

    function handleWhatsAppSend() {
      const name = document.getElementById('contact_name').value || 'N/A';
      const company = document.getElementById('contact_company').value || 'N/A';
      const product = document.getElementById('contact_product').value || 'Heating Cable';
      const message = document.getElementById('contact_msg').value || '';

      const text = encodeURIComponent(`*TechnoTherm Inquiry*\nName: ${name}\nCompany: ${company}\nProduct: ${product}\nNotes: ${message}`);
      window.open(`https://wa.me/<%= data.companyDetails.contact.whatsapp %>?text=${text}`, '_blank');
    }
  </script>
</body>
</html>
